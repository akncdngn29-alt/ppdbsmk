# ========================================================
# ENVIRONMENT VARIABLES UNTUK PRODUCTION (VERCEL / HOSTING)
# ========================================================

# 1. Aplikasi Inti
APP_NAME="PPDB SMK Bina Khalifah"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GANTI_DENGAN_HASIL_php_artisan_key_generate_show
APP_URL=https://nama-projek-anda.vercel.app

# 2. Database Cloud (Aiven / TiDB / Supabase / Clever Cloud)
DB_CONNECTION=mysql
DB_HOST=gateway.xxxx.aivencloud.com
DB_PORT=3306
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=password_database_anda
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# DB_SSLMODE=require # Gunakan baris ini jika menggunakan PostgreSQL Supabase/Neon

# 3. Payment Gateway Midtrans (Sandbox / Production)
# Kunci didapat dari https://dashboard.midtrans.com/ (Settings -> Access Keys)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
MIDTRANS_IS_PRODUCTION=false

# 4. Driver Serverless Vercel (Wajib agar tidak error Read-Only File System)
SESSION_DRIVER=cookie
CACHE_STORE=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr

# 5. File Upload & Storage (Gunakan s3 untuk Supabase Storage / AWS S3 jika diperlukan)
FILESYSTEM_DISK=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=
# AWS_ENDPOINT=

# 6. Mailer / SMTP (Opsional, bawaan: log)
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="admin@sekolah.sch.id"
MAIL_FROM_NAME="${APP_NAME}"
